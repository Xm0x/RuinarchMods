# No game binaries or assets, ever.
*.dll
*.exe
*.pdb

# Build output / deployed copies
build/
bin/
obj/

# Player-generated config (seeded at runtime)
config.json

# Editor / OS
.vs/
.vscode/
.idea/
*.swp
.DS_Store

# Keep our source + a mod's own shipped art (loose PNGs we authored, under art/).
# Game binaries/assets are never committed; mod-authored content is.
!**/*.cs
!**/mod.json
!**/art/**
